# ====================================================================
# Исполняемые файлы и скомпилированный код (C++ / Go / Rust)
# ====================================================================
*.exe
*.out
*.o
*.obj
*.app

# Локальные бинарники компиляции (без расширений), которые часто создаются в Linux/macOS.
# Если вы компилируете файлы без расширения (например, g++ task.cpp -o task),
# лучше складывать их в отдельную папку build/ или bin/ и игнорировать её целиком:
bin/
build/
output/

# ====================================================================
# Файлы кэша Python (если решаете на Python)
# ====================================================================
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/

# ====================================================================
# Файлы Java (если решаете на Java)
# ====================================================================
*.class
*.jar
*.war

# ====================================================================
# Тестовые данные и локальные файлы ввода/вывода
# ====================================================================
# Позволяет создавать файлы input.txt и output.txt для локального тестирования,
# чтобы они не отправлялись на GitHub.
input.txt
output.txt
in*.txt
out*.txt
test*.txt

# ====================================================================
# Настройки популярных сред разработки (IDE) и редакторов
# ====================================================================
# VS Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json

# CLion / IntelliJ IDEA / PyCharm (JetBrains)
.idea/
*.cmake
cmake-build-*/

# Xcode (macOS)
*.xcodeproj/
*.xcworkspace/

# Специфичные файлы систем (macOS/Windows)
.DS_Store
Thumbs.db


# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

# Build directories
build/
Build/
build-*/

# CMake generated files
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
install_manifest.txt
compile_commands.json

# Temporary files
*.tmp
*.log
*.bak
*.swp

# vcpkg
vcpkg_installed/

# debug information files
*.dwo

# test output & cache
Testing/
.cache/
